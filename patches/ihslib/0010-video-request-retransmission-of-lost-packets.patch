diff -ru a/src/session/window.c b/src/session/window.c
--- a/src/session/window.c	2026-10-08 21:27:56.935081668 -0700
+++ b/src/session/window.c	2026-10-08 21:27:56.952182688 -0700
@@ -88,6 +88,23 @@
     window->tail.pos = -1;
 }
 
+uint16_t IHS_SessionPacketsWindowMissing(const IHS_SessionPacketsWindow *window, uint16_t *out, uint16_t max,
+                                         uint16_t skipRecent) {
+    uint16_t size = IHS_SessionPacketsWindowSize(window);
+    if (size <= skipRecent) {
+        return 0;
+    }
+    uint16_t limit = size - skipRecent;
+    uint16_t count = 0;
+    for (uint16_t k = 0; k < limit && count < max; k++) {
+        int pos = (window->head.pos + k) % window->capacity;
+        if (!FrameItemIsUsed(&window->data[pos])) {
+            out[count++] = (uint16_t) (window->tail.id - (size - 1) + k);
+        }
+    }
+    return count;
+}
+
 bool IHS_SessionPacketsWindowAdd(IHS_SessionPacketsWindow *window, IHS_SessionPacket *packet) {
     /* Calculate distance of 2 items */
     int tailOffset = window->tail.pos < 0 ? 1 : (int16_t) (packet->header.packetId - window->tail.id);

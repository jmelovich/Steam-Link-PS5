--- a/src/session/channels/video/ch_data_video.c
+++ b/src/session/channels/video/ch_data_video.c
@@ -415,10 +415,21 @@
         return;
     }
     IHS_SessionLog(channel->session, IHS_LogLevelWarn, "Video",
-                   "Partial frames stalled for %u ms, request keyframe", span * 1000 / 65536);
-    IHS_SessionChannelDataLost(channel);
-    videoCh->states.waitingKeyFrame = IHS_TimerNow();
-    videoCh->states.keyframeAskedAt = videoCh->states.waitingKeyFrame;
+                   "Partial frames stalled for %u ms, drop and keep decoding", span * 1000 / 65536);
+    // A stalled partial means one frame never got all its fragments (a lost packet). The old
+    // code hard-waited for a keyframe here, freezing the picture for the whole keyframe
+    // round-trip - measured at 200-640 ms, several times a minute, the worst of the visible
+    // judder. Instead drop the stuck partials so assembly advances to the next frame, ask for
+    // a keyframe once (coalesced) to heal cleanly, and KEEP DECODING. The decoder reset path
+    // (SubmitFrame ReportLost -> ApplyDecoderReset) is still the backstop for a frame that
+    // genuinely can't be decoded without its lost reference, so corruption cannot persist.
+    DiscardPending(videoCh);
+    videoCh->states.frameFinished = false;
+    videoCh->states.frameStarted = false;
+    if (videoCh->states.keyframeAskedAt == 0) {
+        IHS_SessionChannelDataLost(channel);
+        videoCh->states.keyframeAskedAt = IHS_TimerNow();
+    }
 }
 

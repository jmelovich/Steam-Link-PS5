     return true;
 }
+
+bool IHS_RetransmissionResend(IHS_SessionRetransmission *retransmission, IHS_SessionChannelId channelId,
+                              uint16_t packetId, uint16_t fragmentId) {
+    RetransmissionQuery query = {
+            .channelId = channelId,
+            .packetId = packetId,
+            .fragmentId = fragmentId,
+    };
+    IHS_MutexLock(retransmission->lock);
+    PendingRetransmission *match = IHS_QueuePollBy(retransmission->queue, RetransmissionPacketPredicate, &query);
+    if (match == NULL) {
+        IHS_MutexUnlock(retransmission->lock);
+        return false;
+    }
+    uint64_t now = IHS_TimerNow();
+    /* A body of NULL means the periodic retry already handed the packet to the
+     * send queue and this entry is about to be replaced: it is on its way. */
+    bool send = match->packet.body.data != NULL && now - match->lastSentMs >= RESEND_MIN_INTERVAL_MS;
+    IHS_SessionPacket copy;
+    if (send) {
+        match->lastSentMs = now;
+        copy.header = match->packet.header;
+        copy.crc = 0;
+        IHS_SessionPacketBodyInitialize(&copy.body, copy.header.hasCrc);
+        IHS_BufferAppend(&copy.body, &match->packet.body);
+    }
+    /* Put it back; the periodic retry keeps running as the fallback. */
+    IHS_QueueAppend(retransmission->queue, match);
+    IHS_MutexUnlock(retransmission->lock);
+    if (send) {
+        IHS_SessionLog(retransmission->session, IHS_LogLevelVerbose, "Retransmission",
+                       "Resend on NACK Packet(channelId=%u, packetId=%u, fragmentId=%u)", channelId, packetId,
+                       fragmentId);
+        IHS_SessionQueuePacket(retransmission->session, &copy, false);
+        IHS_SessionPacketClear(&copy, true);
+    }
+    return true;
+}
 
 static void RetransmissionQueueItemDestroy(PendingRetransmission *item, void *context) {
     (void) context;

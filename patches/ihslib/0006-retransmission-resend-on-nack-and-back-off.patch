+++ b/src/ihs_queue.c	2026-10-08 20:07:52.979694339 -0700
@@ -104,6 +104,8 @@
             } else {
                 queue->head = next;
             }
+            /* Detach it like IHS_QueuePoll does, so it can be appended again. */
+            cur->next = NULL;
             return item;
         }

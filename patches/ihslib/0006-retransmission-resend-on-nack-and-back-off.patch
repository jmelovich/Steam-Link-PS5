diff -ru a/src/session/retransmission.c b/src/session/retransmission.c
--- a/src/session/retransmission.c	2026-10-08 17:01:34.255289291 -0700
+++ b/src/session/retransmission.c	2026-10-08 20:07:52.979619837 -0700
@@ -26,13 +26,31 @@
 #include "retransmission.h"
 #include "session_pri.h"
 
-#define RETRANSMISSION_INTERVAL 10
 #define RETRANSMISSION_ATTEMPTS 20
+/* A NACK-driven resend of the same packet is not repeated faster than this. */
+#define RESEND_MIN_INTERVAL_MS 30
+
+/*
+ * Delay before the n-th retry (n >= 1). The old fixed 10 ms schedule sent every
+ * reliable packet 21 times in 200 ms and then forgot it: on a Wi-Fi link whose
+ * round trip is longer than 10 ms every packet went out several times, and once
+ * one was lost for good the host NACKed every later packet forever. Back off
+ * from 60 ms to 1 s and keep the packet for about 17 s; the host's NACKs
+ * (IHS_RetransmissionResend) are what recover a lost packet quickly.
+ */
+static uint32_t RetransmissionDelay(uint8_t retransmitCount) {
+    if (retransmitCount == 0) {
+        return 60;
+    }
+    uint32_t delay = 60u << (retransmitCount - 1);
+    return delay > 1000 ? 1000 : delay;
+}
 
 typedef struct IHS_QueueItem {
     IHS_SessionPacket packet;
     IHS_TimerTask *task;
     IHS_SessionRetransmission *retransmission;
+    uint64_t lastSentMs;
 } PendingRetransmission;
 
 typedef struct RetransmissionQuery {
@@ -74,9 +92,10 @@
     pending->packet = *packet;
     pending->retransmission = retransmission;
     pending->packet.header.retransmitCount++;
+    pending->lastSentMs = IHS_TimerNow();
     IHS_BufferTransferOwnership(&packet->body, &pending->packet.body);
     pending->task = IHS_TimerTaskStart(retransmission->session->timers, RetransmissionTimerRun, RetransmissionTimerEnd,
-                                       RETRANSMISSION_INTERVAL, pending);
+                                       RetransmissionDelay(pending->packet.header.retransmitCount), pending);
     IHS_MutexLock(retransmission->lock);
     IHS_QueueAppend(retransmission->queue, pending);
     IHS_MutexUnlock(retransmission->lock);
@@ -109,6 +128,44 @@
